[Unit]
Description=Carbon Quickshell Desktop Shell
After=graphical-session.target

[Service]
Type=simple
EnvironmentFile=-%h/.config/hypr/carbon-shell.env
ExecStart=/usr/bin/bash -c 'if [ -x %h/.local/bin/quickshell ]; then exec %h/.local/bin/quickshell --config %h/.local/share/quickshell/carbon; else exec /usr/bin/quickshell --config %h/.local/share/quickshell/carbon; fi'
Restart=always
RestartSec=2
Environment=QT_QPA_PLATFORM=wayland
Environment=XDG_CURRENT_DESKTOP=Hyprland

[Install]
WantedBy=default.target
